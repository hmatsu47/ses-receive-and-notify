{
  "name": "ses-receive-and-notify",
  "version": "0.1.0",
  "description": "SES received mail -> S3 -> decode -> S3 -> Slack notification tool",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"{src,test,infra}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test,infra}/**/*.ts\" --fix",
    "format": "prettier --check \"{src,test,infra}/**/*.ts\"",
    "format:fix": "prettier --write \"{src,test,infra}/**/*.ts\"",
    "test": "vitest run test/",
    "test:watch": "vitest",
    "cdk": "cdk"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1133.0",
    "@aws-sdk/client-secrets-manager": "3.1133.0",
    "mailparser": "3.9.28"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/aws-lambda": "8.10.163",
    "@types/mailparser": "3.4.6",
    "@types/node": "22.20.3",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "aws-cdk": "2.1141.0",
    "aws-cdk-lib": "2.269.0",
    "aws-sdk-client-mock": "4.1.0",
    "constructs": "10.8.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "esbuild": "0.28.2",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
