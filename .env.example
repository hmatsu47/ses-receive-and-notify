# ============================================================
# 環境設定サンプル (.env.example)
#
# CDK デプロイ時に設定する環境変数のサンプル。実行前に .env を環境変数として
# エクスポートしてから cdk を実行する (set -a; . ./.env; set +a)。
# 秘匿値 (SLACK_WEBHOOK_URL) は Secrets Manager から実行時に供給し、
# ソース・IaC・Lambda 環境変数に平文で残さない (FR4.1 / NFR3.6)。
# .env はコミットしない (.gitignore 済み)。
#
# 凡例: [必須] は未設定だと Lambda 実行時に fail loud する。[任意] は既定値あり。
# ============================================================

# [必須] 対象受信ドメイン。既定値なし (環境固有のため付与しない)。
TARGET_DOMAIN=example.com

# [任意] 添付デコードの合計上限 (バイト)。未設定・不正値時は既定 10MB (10485760)。
ATTACHMENT_TOTAL_LIMIT_BYTES=10485760

# [任意] AWS リージョン。未設定時は Lambda / SDK 実行環境から解決。
AWS_REGION=ap-northeast-1

# ------------------------------------------------------------
# 秘匿値の実行時供給 (Secrets Manager)
# SLACK_WEBHOOK_URL を格納した Secret (JSON) を事前に作成し、以下 2 つを設定する。
# ------------------------------------------------------------

# [必須] Lambda 実行時に読み込む Secret 名/ID。
#   当該 Secret (JSON) の SLACK_WEBHOOK_URL を実行時に読み込む。
#   ※これは秘匿値ではない (名前/ID)。Lambda 環境変数に設定される。
SECRETS_MANAGER_SECRET_ID=ses-notify/secrets

# [必須] Lambda へ read 権限を与える Secret の ARN。
#   SECRETS_MANAGER_SECRET_ID と対で設定する (同じ Secret を指す)。
#   例: arn:aws:secretsmanager:ap-northeast-1:123456789012:secret:ses-notify-xxxxxx
SECRETS_MANAGER_SECRET_ARN=

# ------------------------------------------------------------
# CDK 標準 (任意)
# ------------------------------------------------------------

# [任意] スタックの env.account / env.region (CDK 標準)。
# CDK_DEFAULT_ACCOUNT=123456789012
# CDK_DEFAULT_REGION=ap-northeast-1
